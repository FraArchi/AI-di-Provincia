---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation';
import ArticleCTA from '../../components/ArticleCTA.astro';
import { getRubriche } from '../../lib/utils';
import { ArrowLeft } from 'lucide-react';
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.data.slug || post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const rubriche = await getRubriche();

// Ottimizzazione immagine per Open Graph e Schema.org
const optimizedCover = post.data.cover 
  ? await getImage({ src: post.data.cover, format: 'webp', width: 1200, height: 630 }) 
  : null;
const ogImage = optimizedCover ? optimizedCover.src : undefined;

const allPosts = await getCollection('posts');
const relatedPosts = allPosts
  .filter(p => p.id !== post.id && p.data.category === post.data.category)
  .sort((a, b) => new Date(b.data.published_date).valueOf() - new Date(a.data.published_date).valueOf())
  .slice(0, 2);

// Se non ci sono abbastanza post correlati, riempiamo con i più recenti
if (relatedPosts.length < 2) {
  const recentPosts = allPosts
    .filter(p => p.id !== post.id && !relatedPosts.some(rp => rp.id === p.id))
    .sort((a, b) => new Date(b.data.published_date).valueOf() - new Date(a.data.published_date).valueOf())
    .slice(0, 2 - relatedPosts.length);
  relatedPosts.push(...recentPosts);
}

const words = post.body ? post.body.split(/\s+/).length : 0;
const readingTime = Math.ceil(words / 200) || 1;

const formatDate = (dateString: string | Date) => {
  const date = new Date(dateString);
  return date.toLocaleDateString('it-IT', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
};
---

<Layout 
  title={`${post.data.title} - AI di Provincia`} 
  description={post.data.subtitle || post.data.excerpt || ''}
  image={ogImage}
>
  <!-- Schema.org Structured Data -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": post.data.title,
    "description": post.data.subtitle || post.data.excerpt || "",
    "image": ogImage ? new URL(ogImage, Astro.site) : undefined,
    "datePublished": post.data.published_date,
    "author": {
      "@type": "Person",
      "name": post.data.author
    },
    "publisher": {
      "@type": "Organization",
      "name": "AI di Provincia",
      "logo": {
        "@type": "ImageObject",
        "url": new URL('/images/og-image.png', Astro.site)
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": new URL(Astro.url.pathname, Astro.site)
    }
  })} />

  <Navigation client:load currentPage="article" rubriche={rubriche} />
  
  <main class="flex-grow">
    <div class="bg-white">
      <div class="max-w-3xl mx-auto px-6 py-16">
        <a
          href="/"
          class="text-sm text-gray-600 hover:text-accent transition-colors flex items-center gap-2 mb-12 inline-flex"
        >
          <ArrowLeft size={16} />
          Torna alla home
        </a>

        <article>
          {post.data.category && (
            <span class="text-sm font-mono text-accent uppercase tracking-widest mb-6 block">
              {post.data.category}
            </span>
          )}

          <h1 class="text-5xl font-serif font-bold text-gray-900 mb-6 leading-tight">
            {post.data.title}
          </h1>

          {post.data.subtitle && (
            <p class="text-2xl text-gray-600 mb-8 leading-relaxed">
              {post.data.subtitle}
            </p>
          )}

          <div class="flex gap-4 text-sm font-mono text-gray-500 tracking-tight mb-12 pb-8 border-b border-gray-200">
            <span class="font-medium">{post.data.author}</span>
            <span>&middot;</span>
            <span>{formatDate(post.data.published_date)}</span>
            <span>&middot;</span>
            <span>{readingTime} min di lettura</span>
          </div>

          {post.data.cover && (
            <div class="mb-12">
              <Image 
                src={post.data.cover} 
                alt={post.data.title} 
                class="w-full h-auto object-cover rounded-xl shadow-sm border border-gray-100" 
              />
            </div>
          )}

          <div class="article-content prose prose-lg max-w-none text-gray-800 leading-relaxed mb-16">
            <Content />
          </div>

          {post.data.cta_text && (
            <ArticleCTA text={post.data.cta_text} image={post.data.cta_image} />
          )}
        </article>
      </div>
    </div>

    {/* Sezione Potrebbe interessarti anche... */}
    {relatedPosts.length > 0 && (
      <div class="bg-gray-50 py-16 border-t border-gray-200">
        <div class="max-w-4xl mx-auto px-6">
          <h3 class="text-2xl font-serif font-bold text-gray-900 mb-8 text-center">
            Potrebbe interessarti anche...
          </h3>
          <div class="grid sm:grid-cols-2 gap-8">
            {relatedPosts.map(rp => (
              <article class="group bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition-shadow">
                <a href={`/post/${rp.data.slug || rp.id}`} class="block h-full flex flex-col">
                  {rp.data.cover && (
                    <div class="w-full aspect-[16/9] overflow-hidden bg-gray-100">
                      <Image 
                        src={rp.data.cover} 
                        alt={rp.data.title} 
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      />
                    </div>
                  )}
                  <div class="p-6 flex flex-col flex-grow">
                    {rp.data.category && (
                      <span class="text-xs font-mono text-accent uppercase tracking-widest mb-2 block">
                        {rp.data.category}
                      </span>
                    )}
                    <h4 class="text-xl font-serif font-bold text-gray-900 mb-2 group-hover:text-accent transition-colors leading-snug">
                      {rp.data.title}
                    </h4>
                    <div class="mt-auto pt-4 flex gap-2 text-xs font-mono text-gray-500 tracking-tight">
                      <span>{formatDate(rp.data.published_date)}</span>
                    </div>
                  </div>
                </a>
              </article>
            ))}
          </div>
        </div>
      </div>
    )}
  </main>
</Layout>
