---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation';
import { getRubriche } from '../lib/utils';

const rubriche = await getRubriche();

const exercises = [
  {
    id: "01",
    title: "Il rito della prima pagina",
    description: "Non iniziare a leggere se non hai almeno 20 minuti di silenzio garantito. Spegni il telefono o lascialo in un'altra stanza. La lettura lenta inizia con un atto di separazione."
  },
  {
    id: "02",
    title: "Il taccuino analogico",
    description: "Leggi con una penna in mano. Sottolinea non quello che è importante, ma quello che ti risuona dentro. Annota a margine i tuoi dubbi, le tue rabbie, le tue gioie. Trasforma il libro in un dialogo."
  },
  {
    id: "03",
    title: "L'esercizio del paragrafo singolo",
    description: "Scegli un paragrafo particolarmente denso. Leggilo tre volte. La prima per capire cosa dice. La seconda per capire come lo dice. La terza per lasciarlo sedimentare senza cercare di capire nulla."
  },
  {
    id: "04",
    title: "La pausa del paesaggio",
    description: "Ogni 10 pagine, chiudi il libro. Guarda fuori dalla finestra. Non pensare a quello che hai letto. Lascia che il cervello faccia le sue connessioni invisibili mentre osservi il mondo reale."
  },
  {
    id: "05",
    title: "Il contrasto algoritmico",
    description: "Dopo aver letto un capitolo difficile, prova a chiedere a un'AI di riassumerlo. Nota cosa manca nel riassunto: mancherà la tua emozione, il tuo ricordo personale associato a una parola, il peso del silenzio tra le righe. Quel vuoto è la tua umanità."
  },
  {
    id: "06",
    title: "La rilettura come fedeltà",
    description: "I libri che contano non si leggono, si rileggono. Scegli un libro che ti ha cambiato la vita cinque anni fa. Leggilo di nuovo ora. Vedrai che il libro è rimasto lo stesso, ma tu sei diventato un altro lettore."
  }
];
---

<Layout title="Esercizi di Lettura Lenta - AI di Provincia">
  <Navigation client:load currentPage="lettura-lenta" rubriche={rubriche} />
  
  <main class="flex-grow bg-gray-50 py-20">
    <div class="max-w-3xl mx-auto px-6">
      <div class="bg-white p-12 md:p-20 shadow-xl rounded-2xl border border-gray-100 relative overflow-hidden text-center">
        {/* Decorative Element */}
        <div class="absolute top-0 left-0 w-full h-2 bg-accent opacity-50"></div>
        
        <div class="mb-16">
          <span class="text-accent font-mono text-sm uppercase tracking-[0.3em] mb-4 block">Pratica della Lentezza</span>
          <h1 class="text-4xl md:text-6xl font-serif font-bold text-gray-900 mb-6">
            Esercizi di Lettura Lenta
          </h1>
          <p class="text-xl text-gray-600 italic max-w-2xl mx-auto">
            Guida alla profondità nell'era dell'attenzione frammentata
          </p>
        </div>

        <div class="space-y-16 text-left">
          {exercises.map((ex) => (
            <section class="group">
              <div class="flex items-center gap-4 mb-4">
                <span class="text-xs font-mono text-accent/60 border border-accent/20 px-2 py-1 rounded">ESERCIZIO {ex.id}</span>
                <div class="h-px flex-grow bg-gray-100"></div>
              </div>
              <h3 class="text-2xl font-serif font-bold text-gray-900 mb-4 group-hover:text-accent transition-colors">
                {ex.title}
              </h3>
              <p class="text-gray-700 leading-relaxed text-lg">
                {ex.description}
              </p>
            </section>
          ))}
        </div>

        <div class="mt-24 pt-12 border-t border-gray-100">
          <p class="text-sm font-mono text-gray-400 uppercase tracking-widest mb-8">
            Coltiva il tuo Sostrato &middot; Rallenta
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/manifesto" class="text-gray-600 hover:text-gray-900 font-medium">
              &larr; Leggi il Manifesto
            </a>
            <span class="hidden sm:block text-gray-300">|</span>
            <a href="/" class="text-accent hover:underline font-medium">
              Torna alla Home
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
