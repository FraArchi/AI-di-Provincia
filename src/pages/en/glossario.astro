---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation';
import { getRubriche } from '../../lib/utils';

const rubriche = await getRubriche('en');

const terms = [
  {
    id: "01",
    term: "Large Language Model (LLM)",
    metaphor: "The Village Square",
    description: "A collective memory that doesn't think, but remembers the frequency of words like an elder completing an ancient proverb."
  },
  {
    id: "02",
    term: "Prompt",
    metaphor: "The Fireside Beginning",
    description: "The spark that initiates the dialogue. The more precise the beginning, the richer in meaning and truth the story you receive will be."
  },
  {
    id: "03",
    term: "RAG",
    metaphor: "The Priest's Library",
    description: "The act of consulting real documents before answering, to prevent the memory of the square from inventing events that never happened."
  },
  {
    id: "04",
    term: "Latent Space",
    metaphor: "The Seed Warehouse",
    description: "The invisible universe where concepts are close by nature and affinity, not by alphabetical order."
  },
  {
    id: "05",
    term: "Training",
    metaphor: "The Harvest Season",
    description: "The time of sowing and caring for thought, producing a model capable of nourishing our questions."
  },
  {
    id: "06",
    term: "Weights",
    metaphor: "The Well-Worn Paths",
    description: "The preferred paths of artificial thought, traced by the experience of billions of previous conversations."
  },
  {
    id: "07",
    term: "Token",
    metaphor: "The Grains of Wheat",
    description: "The elementary particles of communication. The minimum unit of meaning that the machine grinds to produce white flour."
  },
  {
    id: "08",
    term: "Hallucination",
    metaphor: "The Midday Heat Mirage",
    description: "When too much light of statistics makes us see things that do not exist, but which take the reassuring shape of truth."
  }
];
---

<Layout title="Glossary of the New World - AI di Provincia">
  <Navigation client:load currentPage="glossario" rubriche={rubriche} lang="en" currentPath={Astro.url.pathname} />
  
  <main class="flex-grow bg-gray-50 py-20">
    <div class="max-w-4xl mx-auto px-6">
      <div class="bg-white p-12 md:p-20 shadow-xl rounded-2xl border border-gray-100 relative overflow-hidden">
        {/* Decorative Element */}
        <div class="absolute top-0 right-0 w-32 h-32 bg-accent/5 rounded-full -mr-16 -mt-16"></div>
        <div class="absolute bottom-0 left-0 w-24 h-24 bg-accent/5 rounded-full -ml-12 -mb-12"></div>
        
        <div class="text-center mb-20">
          <span class="text-accent font-mono text-sm uppercase tracking-[0.3em] mb-4 block">Anthropological Dictionary</span>
          <h1 class="text-4xl md:text-6xl font-serif font-bold text-gray-900 mb-6">
            Glossary of the New World
          </h1>
          <p class="text-xl text-gray-600 italic max-w-2xl mx-auto">
            Translating artificial intelligence into the language of the land
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-x-12 gap-y-16">
          {terms.map((item) => (
            <div class="group">
              <div class="flex items-baseline gap-2 mb-2">
                <span class="text-accent font-mono text-xs">{item.id}</span>
                <h3 class="text-lg font-bold text-gray-900 uppercase tracking-tight group-hover:text-accent transition-colors">
                  {item.term}
                </h3>
              </div>
              <p class="text-sm font-serif italic text-accent mb-4">
                &mdash; {item.metaphor}
              </p>
              <p class="text-gray-600 leading-relaxed">
                {item.description}
              </p>
            </div>
          ))}
        </div>

        <div class="mt-24 pt-12 border-t border-gray-100 text-center">
          <p class="text-sm font-mono text-gray-400 uppercase tracking-widest mb-8">
            Inhabit technology with your own words
          </p>
          <div class="flex flex-col sm:flex-row gap-6 justify-center">
             <a href="/en/manifesto" class="text-gray-600 hover:text-accent font-medium transition-colors">
              The Manifesto
            </a>
            <a href="/en/margini-di-pagina" class="text-gray-600 hover:text-accent font-medium transition-colors">
              Page Margins
            </a>
            <a href="/en" class="text-accent hover:underline font-bold">
              Back to Home &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
