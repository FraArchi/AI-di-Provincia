---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation';
import { getRubriche } from '../../lib/utils';
import { getCollection } from 'astro:content';
import { marked } from 'marked';
import { Image } from 'astro:assets';

const rubriche = await getRubriche('en');
const posts = await getCollection('posts', ({ id, data }) => {
  return id.startsWith('en/') || data.lang === 'en';
});

const sortedPosts = posts.sort((a, b) => new Date(b.data.published_date).valueOf() - new Date(a.data.published_date).valueOf());

const featuredArticle = sortedPosts.find(a => a.data.mainFeatured) || sortedPosts.find(a => a.data.featured && !a.data.featuredOrder) || sortedPosts.find(a => a.data.featured);
const otherArticles = sortedPosts.filter(a => a.id !== featuredArticle?.id);

const sidebarFeaturedPosts = sortedPosts
  .filter(a => a.data.featured)
  .sort((a, b) => (a.data.featuredOrder || 99) - (b.data.featuredOrder || 99));

const formatDate = (dateString: string | Date) => {
  const date = new Date(dateString);
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
};

const getPostUrl = (article: any) => {
  const slug = article.data.slug || article.id.replace(/^en\//, '');
  return `/en/post/${slug}`;
};
---

<Layout title="AI di Provincia - Home">
  <Navigation client:load currentPage="home" rubriche={rubriche} lang="en" currentPath={Astro.url.pathname} />
  
  <main class="flex-grow">
    <div class="bg-white">
      <div class="max-w-6xl mx-auto px-6 py-16">
        <div class="mb-16 pb-8 border-b border-gray-200">
          <h1 class="text-5xl font-serif font-bold text-gray-900 mb-3">
            AI di Provincia
          </h1>
          <p class="text-xl text-gray-600">
            Artificial intelligence seen by those living far from major tech hubs
          </p>
        </div>

        {featuredArticle && (
          <article class="mb-20">
            {featuredArticle.data.category && (
              <span class="text-sm font-mono text-accent uppercase tracking-widest mb-4 block">
                {featuredArticle.data.category}
              </span>
            )}
            
            {featuredArticle.data.cover && (
              <a href={getPostUrl(featuredArticle)} class="block mb-6 overflow-hidden rounded-xl shadow-sm border border-gray-100 group">
                <Image 
                  src={featuredArticle.data.cover} 
                  alt={featuredArticle.data.title} 
                  class="w-full h-[400px] md:h-[500px] object-cover group-hover:scale-105 transition-transform duration-500" 
                />
              </a>
            )}

            <h2 class="text-5xl font-serif font-bold text-gray-900 mb-4 leading-tight hover:text-accent transition-colors">
              <a href={getPostUrl(featuredArticle)}>
                {featuredArticle.data.title}
              </a>
            </h2>
            {featuredArticle.data.subtitle && (
              <p class="text-2xl text-gray-600 mb-8 leading-relaxed">
                {featuredArticle.data.subtitle}
              </p>
            )}
            <div class="flex gap-4 text-sm font-mono text-gray-500 tracking-tight mb-8 pb-8 border-b border-gray-200">
              <span class="font-medium">{featuredArticle.data.author}</span>
              <span>&middot;</span>
              <span>{formatDate(featuredArticle.data.published_date)}</span>
            </div>

            <div class="excerpt-content max-w-none mb-8 text-gray-800 leading-relaxed text-lg line-clamp-6">
              {featuredArticle.data.excerpt || featuredArticle.data.subtitle}
            </div>

            <a
              href={getPostUrl(featuredArticle)}
              class="inline-block text-accent font-medium hover:underline transition-colors"
            >
              Read full article &rarr;
            </a>
          </article>
        )}

        {/* Banner English version announcement */}
        <div class="my-12 p-6 bg-gray-50 border-l-4 border-accent rounded-r-xl">
          <p class="text-gray-800 leading-relaxed">
            <strong class="text-accent">New:</strong> This blog is now available in English. 
            You can switch to the Italian version using the language selector in the top right. 
            I did this for Ann, a very special Taiwanese girl, because I wanted her to be able to read my deeper writings even though she doesn't speak Italian. And also so that almost anyone can read them.
          </p>
        </div>

        {otherArticles.length > 0 && (
          <div class="grid md:grid-cols-3 gap-12 border-t border-gray-200 pt-12">
            
            {/* Feed Centrale (Articoli Principali) - 2/3 width */}
            <div class="md:col-span-2">
              <h3 class="text-xl font-bold font-serif text-gray-900 mb-8 border-b pb-2">Recent Articles</h3>
              <div class="grid sm:grid-cols-2 gap-8">
                {otherArticles.filter(a => a.data.category !== "Il Bollettino dell'IA").map((article) => (
                  <article class="group">
                    <a
                      href={getPostUrl(article)}
                      class="text-left w-full block"
                    >
                      {article.data.cover && (
                        <div class="mb-4 overflow-hidden rounded-xl shadow-sm border border-gray-100 aspect-[16/9]">
                          <Image 
                            src={article.data.cover} 
                            alt={article.data.title} 
                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" 
                          />
                        </div>
                      )}
                      {article.data.category && (
                        <span class="text-xs font-mono text-accent uppercase tracking-widest mb-2 block">
                          {article.data.category}
                        </span>
                      )}
                      <h4 class="text-xl font-serif font-bold text-gray-900 mb-2 group-hover:text-accent transition-colors leading-snug">
                        {article.data.title}
                      </h4>
                      <p class="text-sm text-gray-600 mb-3 line-clamp-2">
                        {article.data.excerpt || article.data.subtitle}
                      </p>
                      <div class="flex gap-2 text-xs font-mono text-gray-500 tracking-tight">
                        <span>{article.data.author}</span>
                        <span>&middot;</span>
                        <span>{formatDate(article.data.published_date)}</span>
                      </div>
                    </a>
                  </article>
                ))}
              </div>
            </div>

            {/* Sidebar Laterale (Favorites) - 1/3 width */}
            <div class="md:col-span-1 bg-gray-50 p-6 rounded-xl border border-gray-100">
              <h3 class="text-lg font-bold font-serif text-gray-900 mb-6 flex items-center gap-2">
                <span class="text-accent">★</span> Favorites
              </h3>
              <div class="space-y-6">
                {sidebarFeaturedPosts.map((article) => (
                  <article class="border-b border-gray-200 pb-6 last:border-0 last:pb-0">
                     <a
                      href={getPostUrl(article)}
                      class="text-left w-full group flex gap-4 items-start"
                    >
                      {article.data.cover && (
                        <div class="shrink-0 w-20 h-20 overflow-hidden rounded-md shadow-sm border border-gray-100">
                          <Image 
                            src={article.data.cover} 
                            alt={article.data.title} 
                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" 
                          />
                        </div>
                      )}
                      <div class="flex-1">
                        {article.data.category && (
                          <span class="text-xs font-mono text-accent uppercase tracking-widest mb-1 block">
                            {article.data.category}
                          </span>
                        )}
                        <h4 class="text-base font-serif font-bold text-gray-900 mb-1 group-hover:text-accent transition-colors leading-tight">
                          {article.data.title}
                        </h4>
                        {article.data.subtitle && (
                          <p class="text-xs text-gray-600 mt-1 line-clamp-2">
                            {article.data.subtitle}
                          </p>
                        )}
                      </div>
                    </a>
                  </article>
                ))}
                
                {sidebarFeaturedPosts.length === 0 && (
                  <p class="text-sm text-gray-500 italic">No favorite articles.</p>
                )}
              </div>
            </div>

          </div>
        )}
      </div>
    </div>
  </main>
</Layout>
