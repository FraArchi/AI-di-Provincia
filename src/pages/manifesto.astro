---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation';
import { getRubriche } from '../lib/utils';

const rubriche = await getRubriche();

const points = [
  {
    title: "L'IA è un utensile, non un oracolo",
    description: "È un'estensione della nostra capacità, non un sostituto del nostro giudizio."
  },
  {
    title: "Il valore è nella lentezza",
    description: "Mentre l'algoritmo accelera, noi rivendichiamo il diritto al tempo per la riflessione, lo studio e la noia creativa."
  },
  {
    title: "La provincia come centro",
    description: "Le periferie geografiche sono i laboratori ideali per testare un'IA umana, libera dalle frenesie della Silicon Valley."
  },
  {
    title: "Trasparenza del Sostrato",
    description: "Dobbiamo comprendere le basi filosofiche e i bias dei modelli che usiamo. La conoscenza è la prima difesa."
  },
  {
    title: "L'errore è un tesoro",
    description: "L'IA non sbaglia, allucina. Noi umani invece impariamo dal fallimento. Rivendichiamo la bellezza dell'imperfezione."
  },
  {
    title: "Interviste, non dati",
    description: "Crediamo nelle storie delle persone reali, come Monastera, più che nelle statistiche aggregate."
  },
  {
    title: "IA Etica per la PA",
    description: "La tecnologia deve semplificare la vita del cittadino nel comune più vicino, non aggiungere strati di burocrazia digitale."
  },
  {
    title: "Il primato dell'analogico",
    description: "Un libro di Camus resta più 'intelligente' di un prompt ben scritto. L'analogico nutre il digitale."
  },
  {
    title: "Curatela umana sempre",
    description: "Non delegare mai la scelta finale a una macchina. Sii tu l'ultimo filtro della tua vita."
  },
  {
    title: "Restiamo curiosi, restiamo provinciali",
    description: "Aperto al mondo, radicato nella terra. L'intelligenza artificiale ci aiuti a essere più uomini, non più macchine."
  }
];
---

<Layout title="Manifesto della Tecnologia Restante - AI di Provincia">
  <Navigation client:load currentPage="manifesto" rubriche={rubriche} />
  
  <main class="flex-grow bg-gray-50 py-20">
    <div class="max-w-3xl mx-auto px-6">
      <div class="bg-white p-12 md:p-20 shadow-xl rounded-2xl border border-gray-100 relative overflow-hidden">
        {/* Decorative Element */}
        <div class="absolute top-0 left-0 w-full h-2 bg-accent"></div>
        
        <div class="text-center mb-16">
          <span class="text-accent font-mono text-sm uppercase tracking-[0.3em] mb-4 block">Documento Fondativo</span>
          <h1 class="text-4xl md:text-6xl font-serif font-bold text-gray-900 mb-6">
            Manifesto della Tecnologia Restante
          </h1>
          <p class="text-xl text-gray-600 italic">
            10 Punti per restare umani tra un algoritmo e l'altro
          </p>
        </div>

        <div class="space-y-12">
          {points.map((point, index) => (
            <div class="flex gap-6 group">
              <span class="text-3xl font-serif font-bold text-accent/20 group-hover:text-accent transition-colors duration-500">
                {(index + 1).toString().padStart(2, '0')}
              </span>
              <div>
                <h3 class="text-xl font-serif font-bold text-gray-900 mb-2">
                  {point.title}
                </h3>
                <p class="text-gray-600 leading-relaxed">
                  {point.description}
                </p>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-20 pt-12 border-t border-gray-100 text-center">
          <p class="text-sm font-mono text-gray-400 uppercase tracking-widest">
            AI di Provincia &middot; Dalla Periferia dell'Innovazione
          </p>
          <div class="mt-8">
            <a href="/" class="text-accent hover:underline font-medium">
              &larr; Torna alla Home
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
