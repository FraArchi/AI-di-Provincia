---
import { Image } from 'astro:assets';
import NewsletterForm from './NewsletterForm';

interface Props {
  text: string;
  image: any;
}

const { text, image } = Astro.props;
---

<div class="my-16 py-10 border-l-4 border-accent bg-gray-50/50 px-8 rounded-r-2xl flex flex-col md:flex-row items-center gap-10">
  {image && (
    <div class="w-32 h-32 flex-shrink-0 bg-white rounded-xl p-2 shadow-sm border border-gray-100">
      <Image src={image} alt="Illustrazione personalizzata" class="w-full h-full object-contain" />
    </div>
  )}
  <div class="flex-grow">
    <p class="text-xl font-serif italic text-gray-800 mb-6 leading-relaxed">
      {text}
    </p>
    <div class="w-full">
      <NewsletterForm client:load />
    </div>
  </div>
</div>
