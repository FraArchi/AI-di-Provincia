---
import NewsletterForm from './NewsletterForm';

const lang = Astro.currentLocale || 'it';

const t = {
  it: {
    badge: "Pensiero Lento",
    title: "Restiamo in contatto",
    desc1: "Una lettera periodica tra umanità e algoritmi.",
    desc2: "Niente spam, solo riflessioni per chi vive fuori dai centri tecnologici.",
    followTelegram: "Seguimi anche su",
    unsub: "Puoi disiscriverti in ogni momento. Rispetto la tua attenzione."
  },
  en: {
    badge: "Slow Thinking",
    title: "Let's stay in touch",
    desc1: "A periodic letter between humanity and algorithms.",
    desc2: "No spam, only reflections for those who live away from tech hubs.",
    followTelegram: "Also follow me on",
    unsub: "You can unsubscribe at any time. I respect your attention."
  }
}[lang];
---

<section id="newsletter" class="bg-gray-50 border-t border-b border-gray-200 py-24 px-6">
  <div class="max-w-4xl mx-auto flex flex-col items-center text-center">
    <div class="mb-10 relative">
      <svg width="180" height="80" viewBox="0 0 180 80" class="mx-auto text-gray-900" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M20 60 Q 50 10, 90 60 T 160 20" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
        <circle cx="160" cy="20" r="6" class="fill-accent" />
      </svg>
      <div class="absolute -top-6 -right-12 transform rotate-12 bg-white px-3 py-1 border-2 border-gray-900 text-xs font-mono uppercase tracking-widest shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
        {t.badge}
      </div>
    </div>

    <h2 class="text-4xl md:text-5xl font-serif font-bold text-gray-900 mb-6">{t.title}</h2>
    <p class="text-xl text-gray-600 mb-12 max-w-2xl leading-relaxed">
      {t.desc1} <br class="hidden md:block" />
      {t.desc2}
      <br />
      <span class="text-sm">{t.followTelegram} <a href="https://t.me/AI_di_Provincia" target="_blank" rel="noopener noreferrer" class="text-accent underline hover:no-underline font-medium">Telegram: AI di Provincia</a></span>
    </p>

    <NewsletterForm client:load lang={lang as 'it' | 'en'} />
    
    <p class="mt-10 text-sm text-gray-400 font-mono italic">
      {t.unsub}
    </p>
  </div>
</section>
