---
// Giscus comments component
// Uses GitHub Discussions as backend
---

<div class="giscus-container my-16">
  <h3 class="text-2xl font-serif font-bold text-gray-900 mb-6">
    Commenti
  </h3>
  <div class="bg-white rounded-xl border border-gray-200 p-6">
    <script 
      src="https://giscus.app/client.js"
      data-repo="FraArchi/AI-di-Provincia"
      data-repo-id="R_kgDONGqS8Q"
      data-category="General"
      data-category-id="DIC_kwDONGqS8c4CkxS8"
      data-mapping="pathname"
      data-strict="0"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme="light"
      data-lang="it"
      data-loading="lazy"
      crossorigin="anonymous"
      async>
    </script>
  </div>
</div>

<style>
  .giscus-container :global(.giscus-frame) {
    width: 100%;
  }
</style>
