---
// Custom comments component
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<div class="comments-section my-16">
  <h3 class="text-2xl font-serif font-bold text-gray-900 mb-6">
    Commenti
  </h3>
  
  <!-- Comment form -->
  <div class="bg-white rounded-xl border border-gray-200 p-6 mb-8">
    <h4 class="text-lg font-serif font-bold text-gray-900 mb-4">Lascia un commento</h4>
    <form id="comment-form" class="space-y-4">
      <div>
        <label for="username" class="block text-sm font-mono text-gray-600 mb-1">Nome o Username</label>
        <input
          type="text"
          id="username"
          name="username"
          required
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-accent focus:border-transparent"
          placeholder="Es. Mario Rossi"
        />
      </div>
      <div>
        <label for="text" class="block text-sm font-mono text-gray-600 mb-1">Commento</label>
        <textarea
          id="text"
          name="text"
          rows="4"
          maxlength="2000"
          required
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-accent focus:border-transparent resize-none"
          placeholder="Scrivi il tuo commento..."
        ></textarea>
        <p class="text-xs text-gray-500 mt-1">Massimo 2000 caratteri</p>
      </div>
      <button
        type="submit"
        class="px-6 py-2 bg-accent text-white rounded-lg hover:bg-accent/90 transition-colors font-medium"
      >
        Pubblica commento
      </button>
      <p id="form-message" class="text-sm hidden"></p>
    </form>
  </div>

  <!-- Comments list -->
  <div id="comments-list" class="space-y-6">
    <div class="text-center py-8">
      <span class="animate-pulse text-gray-500">Caricamento commenti...</span>
    </div>
  </div>
</div>

<script define:vars={{ slug }}>
  const form = document.getElementById('comment-form');
  const messageEl = document.getElementById('form-message');
  const commentsList = document.getElementById('comments-list');

  function escapeHtml(str) {
    if (!str) return '';
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  // Load comments
  async function loadComments() {
    try {
      const response = await fetch(`/api/comments?slug=${encodeURIComponent(slug)}`);
      if (!response.ok) throw new Error('Errore nel recupero commenti');
      
      const comments = await response.json();
      
      if (!comments || comments.length === 0) {
        commentsList.innerHTML = '<p class="text-gray-500 text-center py-8">Nessun commento ancora. Sii il primo a commentare!</p>';
        return;
      }
      
      commentsList.innerHTML = comments
        .sort((a, b) => new Date(b.timestamp).getTime() - new Date(a.timestamp).getTime())
        .map(comment => {
          const date = new Date(comment.timestamp);
          const formattedDate = date.toLocaleDateString('it-IT', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
            hour: '2-digit',
            minute: '2-digit'
          });
          
          return `
            <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
              <div class="flex items-start justify-between mb-2">
                <span class="font-medium text-gray-900">${escapeHtml(comment.username)}</span>
                <span class="text-xs text-gray-500">${formattedDate}</span>
              </div>
              <p class="text-gray-700 whitespace-pre-wrap leading-relaxed">${escapeHtml(comment.text)}</p>
            </div>
          `;
        })
        .join('');
    } catch (error) {
      commentsList.innerHTML = '<p class="text-red-500 text-center py-8">Errore nel caricamento dei commenti.</p>';
    }
  }

  // Handle form submission
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(form);
    const username = formData.get('username');
    const text = formData.get('text');

    try {
      const response = await fetch('/api/comments', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slug, username, text })
      });

      if (response.ok) {
        messageEl.textContent = 'Commento pubblicato!';
        messageEl.className = 'text-sm text-green-600 mt-2 block';
        messageEl.classList.remove('hidden');
        form.reset();
        setTimeout(() => messageEl.classList.add('hidden'), 3000);
        await loadComments();
      } else {
        throw new Error('Failed to post comment');
      }
    } catch (error) {
      messageEl.textContent = 'Errore nella pubblicazione. Riprova.';
      messageEl.className = 'text-sm text-red-600 mt-2 block';
      messageEl.classList.remove('hidden');
    }
  });

  // Initial load
  loadComments();
</script>
