---
// Contact box component
const lang = Astro.currentLocale || 'it';
const t = {
  it: {
    title: "Vuoi parlarne?",
    desc: "Se questo articolo ti ha toccato o hai qualcosa da dire, scrivimi. Non gestisco newsletter o canali broadcast — preferisco le conversazioni vere.",
    instagram: "Instagram",
    telegram: "Telegram",
    email: "Email"
  },
  en: {
    title: "Want to talk about it?",
    desc: "If this article touched you or you have something to say, write to me. I don't run newsletters or broadcast channels — I prefer real conversations.",
    instagram: "Instagram",
    telegram: "Telegram",
    email: "Email"
  }
}[lang];
---

<div class="bg-gradient-to-br from-gray-50 to-gray-100 border border-gray-200 rounded-xl p-8 my-12">
  <h3 class="text-xl font-serif font-bold text-gray-900 mb-4">
    {t.title}
  </h3>
  <p class="text-gray-700 mb-6 leading-relaxed">
    {t.desc}
  </p>
  <div class="flex flex-wrap gap-4">
    <a 
      href="https://instagram.com/fra.archi" 
      target="_blank" 
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-300 rounded-lg hover:border-accent hover:text-accent transition-colors font-mono text-sm"
    >
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
      </svg>
      {t.instagram}
    </a>
    <a 
      href="https://t.me/FraArchi" 
      target="_blank" 
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-300 rounded-lg hover:border-accent hover:text-accent transition-colors font-mono text-sm"
    >
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221l-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.446 1.394c-.14.18-.357.223-.548.223l.188-2.85 5.18-4.68c.223-.198-.054-.308-.346-.11l-6.4 4.03-2.76-.918c-.6-.187-.612-.6.125-.89l10.782-4.156c.496-.18.93.108.77.89z"/>
      </svg>
      {t.telegram}
    </a>
    <a 
      href="mailto:fra.archi@hotmail.com"
      class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-300 rounded-lg hover:border-accent hover:text-accent transition-colors font-mono text-sm"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
      </svg>
      {t.email}
    </a>
  </div>
</div>
